        <geom name="cage_left_brace_0" type="capsule" fromto="0.0750 0.0480 0.0700 0.0750 0.0480 0.0170" size="0.0035" material="cage_mat" contype="0" conaffinity="0"/>
        <geom name="cage_left_brace_1" type="capsule" fromto="0.0350 0.0480 0.1000 0.0250 0.0480 0.0150" size="0.0035" material="cage_mat" contype="0" conaffinity="0"/>
