          <geom name="fl_rim" type="cylinder" size="0.019 0.0225" quat="0.70710678 0.70710678 0 0" material="rim_mat" contype="0" conaffinity="0"/>
          <geom name="fl_hub" type="cylinder" size="0.006 0.0245" quat="0.70710678 0.70710678 0 0" material="metal_mat" contype="0" conaffinity="0"/>
        </body>
        </body>
