<?xml version='1.0' encoding='utf-8'?>
<mujoco model="valuetalks_1_16_wheelie_4wd">
  <!-- Photo-inspired 1:16 car. Dimensions not supplied were estimated.
       Coordinate convention: +X front, +Y left, +Z up.
       Nominal axle centers +/-0.095 m; wheel radius 0.0375 m.
       Mass distribution totals exactly 1.300 kg (including 0.352 kg battery).
       A SINGLE 4WD drive actuator is applied via a fixed tendon to all four wheels.
       The independent steering servo is a separate actuator, as on the physical car.
       Chassis pan ground clearance at rest is approximately 0.025 m (25 mm). -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <size njmax="600" nconmax="150"/>
  <statistic center="0 0 0.1" extent="0.42"/>
  <visual>
    <headlight ambient="0.50 0.50 0.50" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2"/>
    <rgba haze="0.9 0.9 0.9 1"/>
  </visual>
  <asset>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.22 0.23 0.25" rgb2="0.3 0.31 0.33" width="512" height="512"/>
    <texture name="battery_side_texture" type="2d" file="battery_side_label.png"/><material name="ground_mat" texture="checker" texrepeat="6 6" reflectance="0.05"/>
    <material name="tire_mat" rgba="0.07 0.07 0.075 1"/>
    <material name="rim_mat" rgba="0.12 0.13 0.15 1" specular="0.35" shininess="0.5"/>
    <material name="frame_mat" rgba="0.075 0.09 0.11 1"/>
    <material name="cage_mat" rgba="0.02 0.43 0.92 1"/>
    <material name="metal_mat" rgba="0.65 0.68 0.72 1"/>
    <material name="battery_mat" rgba="0.055 0.060 0.075 1"/>
    <material name="spring_mat" rgba="0.77 0.12 0.11 1"/>
  <material name="battery_side_mat" texture="battery_side_texture" texrepeat="1 1" texuniform="false" specular="0.12" shininess="0.2"/></asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 -1 3" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="8 8 0.1" material="ground_mat" friction="1.4 0.01 0.002"/>
    <camera name="side" pos="0 -0.65 0.25" euler="74 0 0"/>

    <!-- CHASSIS BODY: 0.401 kg -->
    <body name="chassis" pos="0 0 0.050">
      <freejoint name="root"/>
      <inertial pos="0 0 -0.004" mass="0.401" diaginertia="0.00075 0.00154 0.00196"/>
      <geom name="chassis_pan" type="box" pos="0 0 -0.004" size="0.104 0.060 0.013" material="frame_mat" friction="0.9 0.01 0.001"/>
      <geom name="front_bumper" type="box" pos="0.113 0 -0.003" size="0.009 0.075 0.009" material="frame_mat"/>
      <geom name="rear_bumper" type="box" pos="-0.114 0 -0.003" size="0.010 0.074 0.009" material="frame_mat"/>
      <site name="imu" pos="0 0 0.025" size="0.004" rgba="1 1 0 1"/>

      <!-- BATTERY: 0.352 kg; 144 x 47 x 43 mm. Long axis Y after 90-degree yaw; level mount. Photo-based labels on the battery longitudinal side faces, transformed with the pack. -->
      <body name="battery" pos="-0.043 0 0.132" euler="0 0 90">
        <inertial pos="0 0 0" mass="0.352" diaginertia="0.0001190347 0.0006624933 0.0006730533"/>
        <!-- Two thin blue decals on the upward-facing 144 x 47 mm face. -->
        <!-- Retaining strap wraps across the pack's 47 mm width. -->
        <!-- ONE continuous 144 x 47 x 43 mm battery. Battery local +X is the long direction, world +Y after yaw=90; labels rotate with pack. --><geom name="battery_pack" type="box" size="0.072 0.0235 0.0215" material="battery_mat" friction="0.9 0.01 0.001"/><!-- Photographically rectified 5200 mAh / Zeee wrap on BOTH long vertical faces (XZ plane). --><geom name="battery_side_label_left" type="box" pos="0 0.02362 0" size="0.0714 0.00009 0.02085" material="battery_side_mat" contype="0" conaffinity="0"/><geom name="battery_side_label_right" type="box" pos="0 -0.02362 0" size="0.0714 0.00009 0.02085" material="battery_side_mat" contype="0" conaffinity="0"/><!-- Narrow fabric straps over the TOP (side wrap is already in the photographed label). --><geom name="battery_strap_top_1" type="box" pos="-0.008 0 0.02185" size="0.0014 0.02355 0.00042" rgba="0.025 0.025 0.03 1" contype="0" conaffinity="0"/><geom name="battery_strap_bottom_1" type="box" pos="-0.008 0 -0.02185" size="0.0014 0.02355 0.00042" rgba="0.025 0.025 0.03 1" contype="0" conaffinity="0"/><geom name="battery_strap_top_2" type="box" pos="0.034 0 0.02185" size="0.0014 0.02355 0.00042" rgba="0.025 0.025 0.03 1" contype="0" conaffinity="0"/><geom name="battery_strap_bottom_2" type="box" pos="0.034 0 -0.02185" size="0.0014 0.02355 0.00042" rgba="0.025 0.025 0.03 1" contype="0" conaffinity="0"/><!-- Small white barcode sticker on the rear end of the black pack. --><geom name="battery_barcode" type="box" pos="-0.07225 0 -0.004" size="0.00011 0.012 0.0067" rgba="0.87 0.88 0.86 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_0" type="box" pos="-0.07241 -0.008000 -0.004" size="0.00012 0.000360 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_1" type="box" pos="-0.07241 -0.006667 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_3" type="box" pos="-0.07241 -0.004000 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_4" type="box" pos="-0.07241 -0.002667 -0.004" size="0.00012 0.000360 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_5" type="box" pos="-0.07241 -0.001333 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_7" type="box" pos="-0.07241 0.001333 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_8" type="box" pos="-0.07241 0.002667 -0.004" size="0.00012 0.000360 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_9" type="box" pos="-0.07241 0.004000 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_11" type="box" pos="-0.07241 0.006667 -0.004" size="0.00012 0.000190 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/><geom name="battery_barcode_line_12" type="box" pos="-0.07241 0.008000 -0.004" size="0.00012 0.000360 0.0042" rgba="0.1 0.1 0.11 1" contype="0" conaffinity="0"/></body>

