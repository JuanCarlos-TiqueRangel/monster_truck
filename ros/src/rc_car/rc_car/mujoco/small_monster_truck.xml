      <!-- RR suspension, 70 mm strut and 30 mm max spring stroke -->
      <body name="rr_suspension" pos="-0.095 -0.106 -0.010">
        <joint name="susp_rr" type="slide" axis="0 0 1" limited="true" range="-0.010 0.020" stiffness="450" damping="6.0" springref="0"/>
        <inertial pos="0 0 0" mass="0.008" diaginertia="0.0000013 0.0000013 0.0000013"/>
