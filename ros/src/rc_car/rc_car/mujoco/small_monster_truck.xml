        <inertial pos="0 0 0" mass="0.005" diaginertia="0.0000013 0.0000013 0.0000013"/>
        <geom name="fr_carrier" type="sphere" size="0.010" material="metal_mat" contype="0" conaffinity="0"/>
        <body name="fr_knuckle">
