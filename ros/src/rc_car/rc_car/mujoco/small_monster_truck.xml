        <geom name="cage_left_arch_0" type="capsule" fromto="0.1060 0.0480 0.0060 0.0770 0.0480 0.0690" size="0.0047" material="cage_mat"/>
        <geom name="cage_left_arch_1" type="capsule" fromto="0.0770 0.0480 0.0690 0.0380 0.0480 0.1030" size="0.0047" material="cage_mat"/>
