      <geom name="shock_fr_rod" type="capsule" fromto="0.095 -0.104 -0.002 0.095 -0.104 -0.010" size="0.0035" material="metal_mat" contype="0" conaffinity="0"/>
      <geom name="shock_rl_body" type="capsule" fromto="-0.095 0.070 0.051 -0.095 0.104 -0.002" size="0.0062" material="spring_mat" contype="0" conaffinity="0"/>
