          <geom name="rr_rim" type="cylinder" size="0.019 0.0225" quat="0.70710678 0.70710678 0 0" material="rim_mat" contype="0" conaffinity="0"/>
          <geom name="rr_hub" type="cylinder" size="0.006 0.0245" quat="0.70710678 0.70710678 0 0" material="metal_mat" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Hold both front steering knuckles at the same angle; one servo. -->
  <equality>
    <joint name="steering_link" joint1="steer_fl" joint2="steer_fr" polycoef="0 1 0 0 0"/>
  </equality>

  <!-- One electric motor transmits drive torque to four wheel shafts.
       Equal fixed-tendon coefficients distribute *total* torque four ways.
       This is a simplified torque-split transmission, not a detailed differential.
       With gear=0.50 and ctrl=+1, each wheel receives +0.125 N*m. -->
  <tendon>
    <fixed name="four_wheel_drivetrain">
      <joint joint="spin_fl" coef="0.25"/>
      <joint joint="spin_fr" coef="0.25"/>
      <joint joint="spin_rl" coef="0.25"/>
      <joint joint="spin_rr" coef="0.25"/>
    </fixed>
  </tendon>

  <actuator>
    <motor name="drive" tendon="four_wheel_drivetrain" gear="0.50" ctrllimited="true" ctrlrange="-1 1"/>
    <position name="steering_servo" joint="steer_fl" kp="4" ctrlrange="-0.45 0.45" ctrllimited="true"/>
  </actuator>

  <sensor>
    <accelerometer name="imu_acceleration" site="imu"/>
    <gyro name="imu_angular_velocity" site="imu"/>
    <jointpos name="front_left_suspension" joint="susp_fl"/>
    <jointpos name="front_right_suspension" joint="susp_fr"/>
    <jointpos name="rear_left_suspension" joint="susp_rl"/>
    <jointpos name="rear_right_suspension" joint="susp_rr"/>
  </sensor>
</mujoco>
