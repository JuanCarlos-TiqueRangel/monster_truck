          <geom name="fr_tire" type="cylinder" size="0.0375 0.022" quat="0.70710678 0.70710678 0 0" material="tire_mat" friction="1.5 0.015 0.0015" condim="4"/>
          <geom name="fr_rim" type="cylinder" size="0.019 0.0225" quat="0.70710678 0.70710678 0 0" material="rim_mat" contype="0" conaffinity="0"/>
          <geom name="fr_hub" type="cylinder" size="0.006 0.0245" quat="0.70710678 0.70710678 0 0" material="metal_mat" contype="0" conaffinity="0"/>
        </body>
        </body>
      </body>

      <!-- RL suspension, 70 mm strut and 30 mm max spring stroke -->
      <body name="rl_suspension" pos="-0.095 0.106 -0.010">
        <joint name="susp_rl" type="slide" axis="0 0 1" limited="true" range="-0.010 0.020" stiffness="450" damping="6.0" springref="0"/>
        <inertial pos="0 0 0" mass="0.008" diaginertia="0.0000013 0.0000013 0.0000013"/>
